{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": ".",
      "framework": "django"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend",
        "path": "/api/$1"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "backend",
        "path": "/admin/$1"
      }
    },
    {
      "source": "/((?!assets/|favicon\\.svg|robots\\.txt|sitemap\\.xml|.*\\..*).*)",
      "destination": {
        "service": "frontend",
        "path": "/index.html"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-digest/",
      "schedule": "0 14 * * *"
    }
  ]
}
