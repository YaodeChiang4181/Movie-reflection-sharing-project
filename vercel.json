{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": ".",
      "framework": "django"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend",
        "path": "/api/$1"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "backend",
        "path": "/admin/$1"
      }
    },
    {
      "source": "/auth(.*)",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    },
    {
      "source": "/events(.*)",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    },
    {
      "source": "/search(.*)",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    },
    {
      "source": "/movies/(.*)",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    },
    {
      "source": "/lists/(.*)",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    },
    {
      "source": "/profile(.*)",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    },
    {
      "source": "/liff/(.*)",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend",
        "path": "/$1"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-digest/",
      "schedule": "0 14 * * *"
    }
  ]
}
