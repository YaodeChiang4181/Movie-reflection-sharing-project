{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": ".",
      "framework": "django"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend",
        "path": "/api/$1"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "backend",
        "path": "/admin/$1"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "frontend",
        "path": "/assets/$1"
      }
    },
    {
      "source": "/favicon.svg",
      "destination": {
        "service": "frontend",
        "path": "/favicon.svg"
      }
    },
    {
      "source": "/robots.txt",
      "destination": {
        "service": "frontend",
        "path": "/robots.txt"
      }
    },
    {
      "source": "/sitemap.xml",
      "destination": {
        "service": "frontend",
        "path": "/sitemap.xml"
      }
    },
    {
      "source": "/icons.svg",
      "destination": {
        "service": "frontend",
        "path": "/icons.svg"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend",
        "path": "/index.html"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-digest/",
      "schedule": "0 14 * * *"
    }
  ]
}
